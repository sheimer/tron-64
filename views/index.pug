extends layout

block content
  #layout
    #head
      h1= title
      #gamestats
        #cqi(title='Connecting...')
        #ping connecting...
    #controls
      include controls.pug
    #main
      #welcome
        .welcome-content
          .welcome-hero
            h2(class="fg-water") Bitcycles
            p.welcome-subtitle
              | A modern Web tribute to the legendary Commodore 64 party game 
              a(href="https://www.lemon64.com/game/ultimate-tron-2" target="_blank" rel="noopener noreferrer" class="link-external") Ultimate Tron II
              |  (Oliver Stiller / Masters' Design Group, 1989).
          
          .welcome-section.section-nostalgia
            h3(class="fg-leaf") The Nostalgia: 6 Players on 1 Keyboard
            p Back in the C64 era, up to 6 players crowded shoulder-to-shoulder around a single breadbin keyboard, frantically tapping keys as lightcycles turned with pixel precision.
            p #[strong Bitcycles] brings back that raw couch-multiplayer energy! Play locally on one keyboard or join friends over the internet across laptops, desktops, and mobile phones.

          .welcome-section.section-controls
            h3(class="fg-wood") Controls & Gameplay
            ul.welcome-features
              li #[strong Keyboard:] Select your turn keys (#[code Q/W], #[code Y/X], #[code B/N], #[code K/L], #[code &lt;Down&gt;/&lt;Right&gt;], #[code &lt;Numpad 2&gt;/&lt;3&gt;]).
              li #[strong Mobile / Touch:] On-screen left/right directional buttons for high-speed thumb reflexes.
              li #[strong Trail Kills:] Score bonus points when an opponent crashes into the active tail segment (killzone) of your cycle.
              li #[strong Wall Breach & Escape:] Explosions blast holes in the arena perimeter — navigate through a breach to escape the arena for bonus points!
              li #[strong Objective:] Trap opponents with your light trail, survive simultaneous crashes, and outsmart rivals to lead the scoreboard.

          .welcome-section.section-themes
            h3(class="fg-rose") Color Themes & Accessibility
            p Personalize your grid from the Settings menu with 12 hot-swappable color palettes across Light, Dark, and Auto system appearance:
            ul.welcome-features
              li #[strong Zenbones Family:] #[em Forestbones] (default), #[em Zenbones], #[em Zenburned], #[em Tokyobones], #[em Rosebones], #[em Nordbones], #[em Duckbones], and #[em Seoulbones] — adapted from #[a(href="https://github.com/mcchrish/zenbones.nvim" target="_blank" rel="noopener noreferrer" class="link-external") mcchrish/zenbones.nvim] (MIT).
              li #[strong Retro Displays:] #[em Commodore 64] (authentic VIC-II chip color standard), #[em Arcade Neon] (synthwave vibes), and monochrome phosphor CRTs (#[em Amber CRT] &amp; #[em Green CRT]).
              li #[strong Accessible Contrast:] All palettes are mathematically verified for WCAG 2.1 AA text contrast and Color Vision Deficiency (Deuteranopia &amp; Protanopia) legibility.

          .welcome-section.section-tech
            h3(class="fg-sky") Pure Web Tech Stack
            p Built with zero heavy frameworks: pure ES Modules, deterministic 40 FPS target-timestamp physics loop, binary WebSocket protocol, and an optimized HTML5 canvas delta renderer.
            p.welcome-code-links
              a(href="https://github.com/sheimer/tron" target="_blank" rel="noopener noreferrer" class="link-external")
                i(class="ri-github-fill")
                |  GitHub Repository

          .welcome-footer-note
            p(class="fg-fg-muted small-text")
              | Disclaimer: This project is an independent open-source fan game and tribute. Not affiliated with, sponsored by, or endorsed by The Walt Disney Company.
            p.welcome-links
              a#btn-open-legal(href="#") Impressum / Legal Notice
              |  • 
              a#btn-open-privacy(href="#") Privacy / Datenschutz
      #lobby(style="display:none;")
        p Welcome to #{title}
        p Select or create a new game, please...
        table#gamelisttable
          thead
            tr
              th(style="width: 9%") Id
              th(style="width: 54%") Name
              th(style="width: 18%") #Players
              th(style="width: 15%") Status
              th(style="width: 10%")
          tbody#body-gamelisttable
            tr
              td(colspan="5" class="fg-fg-muted" style="text-align: center; padding: 1.5rem 0;") Connecting to server & fetching games...
      #playersconfig(style="display:none;")
        p Game "#[span#gameName gameName]" (#[span#gameId gameId]) ready, create players!
        table#playerstable
          thead
            tr
              th(style="width: 50%") Name
              th(style="width: 40%") Keys
              th(style="width: 10%")
          tbody#body-playerstable
      canvas#arena
      #playernames
        #playerpos0
        #playerpos1
        #playerpos2
        #playerpos3
        #playerpos4
        #playerpos5
      #scores(style="display:none;")
        p #[span#gamecount] game's results...
        p#messages
        table#scoretable(style="width: 100%;")
          thead
            tr
              th(style="width: 30%") Name
              th(style="width: 14%; text-align: right;") Round
              th(style="width: 14%; text-align: right;") Kills
              th(style="width: 14%; text-align: right;") Killed
              th(style="width: 14%; text-align: right;") Escaped
              th(style="width: 14%; text-align: right;") Total
          tbody#body-scoretable
      #scores-waiting(style="display:none;")
        #scores-waiting-overlay
        #scores-waiting-message
          h1(class='fg-water') waiting for current round to finish
    #footer
      #footer-lobby(style="display:none;")
        form(onsubmit='return false;' id='form-create-game')
          div(class='flex-row')
            input(type='text' value='' placeholder='gamename' id='input-create-game')
            input(type='submit' value=' create game ' id='btn-create-game' disabled=true)
          div#lobby-error(class='fg-rose-muted' style='display:none; margin-top: 0.5rem; text-align: center;')
      #footer-playersconfig(style="display:none;")
        form(onsubmit='return false;' id='form-add-player')
          div(class='flex-row wrap')
            input(type='text' value='' placeholder='playername' id='input-add-player')
            select(id='select-keycodes' required=true)
              option(value='' disabled=true selected=true hidden=true) select left/right turn
              option(value='66_78') b/n
              option(value='89_88') y/x
              option(value='75_76') k/l
              option(value='81_87') q/w
              option(value='40_39') &lt;down>/&lt;right>
              option(value='98_99') &lt;kpad 2>/&lt;kpad 3>
            select(id='msg-no-keycodes' disabled=true)
              option(value='btn1_btn2') btn1/btn2
            input(type='submit' value=' add player ' id='btn-add-player' disabled=true)
            input(type='button' value=' start ' id='btn-init-game' disabled=true)
      #footer-game(style="display:none;")
        form(onsubmit='return false;')
          div(class='flex-row space-between' )
            div(class='flex-row')
              input(type='button' value=' start ' id='btn-start-game' disabled=true)
            #btns(class="flex-row")
              button#btn-left(type='button' aria-label='Turn Left')
                i(class='ri-arrow-left-line')
              button#btn-right(type='button' aria-label='Turn Right')
                i(class='ri-arrow-right-line')
    #palette
      div(class="flex-row small-gap")
        each group in ['bg', 'fg', 'rose', 'leaf', 'wood', 'water', 'blossom', 'sky', 'rock']
          div(class=`group-${group} flex-column`)
            div(class=`color bg-${group}` title=`--color-${group}`)
            div(class=`color bg-${group}-hl` title=`--color-${group}-hl`)
            div(class=`color bg-${group}-muted` title=`--color-${group}-muted`)
  #modal-legal(class='modal' style='display:none;')
    .modal-backdrop
    .modal-content
      .modal-header
        h2 Impressum / Legal Notice
        button.modal-close#btn-close-legal(type='button' aria-label='Close')
          i(class='ri-close-line')
      .modal-body
        h3 Angaben gemäß § 5 DDG
        p
          strong Betreiber / Website Operator:
          br
          | Swen Hoffmann
          br
          | Hiltenspergerstraße 42
          br
          | 80796 München
          br
          | Deutschland
        h3 Kontakt / Contact
        p
          strong E-Mail:
          br
          span.mail-link(data-user="swen" data-domain="debugstube.de")
        h3 Haftungsausschluss / Disclaimer
        p Dieses Projekt ist eine unabhängige, nicht-kommerzielle Open-Source-Hommage an klassische Commodore-64-Spiele. Alle genannten Markennamen, Warenzeichen und eingetragenen Warenzeichen sind Eigentum der jeweiligen Rechteinhaber.
  #modal-privacy(class='modal' style='display:none;')
    .modal-backdrop
    .modal-content
      .modal-header
        h2 Privacy Policy / Datenschutzerklärung
        button.modal-close#btn-close-privacy(type='button' aria-label='Close')
          i(class='ri-close-line')
      .modal-body
        h3 1. Datenschutz auf einen Blick
        p Wir nehmen den Schutz Ihrer Daten ernst. Diese Website verwendet #[strong keine Tracking-Cookies], #[strong keine Werbenetzwerke] und bindet #[strong keine externen CDNs oder Schriftarten von Drittanbietern] ein. Alle Assets werden lokal von unserem Server ausgeliefert.
        h3 2. Server-Logs & WebSocket-Telemetrie
        p Für das Echtzeit-Multiplayer-Spielgeschehen verarbeiten wir temporäre technische Verbindungsdaten (IP-Adresse, WebSocket-Verbindung, Latenz/Ping).
        p Zur Sicherstellung der Serverstabilität erfassen wir rein aggregierte, anonyme Kennzahlen (z.B. Anzahl aktiver Spielräume, Höchststand gleichzeitiger Spieler, Verteilung lokaler vs. entfernter Spieler). Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse am sicheren und reibungslosen Spielbetrieb).
        h3 3. Lokale Einstellungen (LocalStorage / SessionStorage)
        p Ihre Einstellungen (z.B. Farb-Theme, ausgewählte Spielgeschwindigkeit) werden ausschließlich lokal in Ihrem Webbrowser gespeichert.
  #log
