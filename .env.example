# Deployment Configuration Example
# Copy this file to .env and configure your remote server details:
# cp .env.example .env

# Default / Single Target Deployment Configuration:
DEPLOY_TARGET="user@your-server.com"
DEPLOY_PATH="/srv/tron"
DEPLOY_PORT="3000"
DEPLOY_SERVICE_USER="tron"

# Set to true if the remote server uses fnm for Node.js management (uses bitcycles-fnm.service)
# Set to false for modern servers with system-wide Node.js (uses hardened bitcycles.service)
DEPLOY_USE_FNM=false

# Multi-Target Deployment Profiles (Optional):
# Comma or space separated list of profiles to deploy with './scripts/deploy.sh' or './scripts/deploy.sh all':
# DEPLOY_TARGETS="primary,secondary"
#
# Profile 1: primary (e.g. Modern Debian 13 server)
# DEPLOY_PRIMARY_TARGET="hidden@bitcycles.net"
# DEPLOY_PRIMARY_PATH="/srv/tron"
# DEPLOY_PRIMARY_PORT="3042"
# DEPLOY_PRIMARY_SERVICE_USER="tron"
# DEPLOY_PRIMARY_USE_FNM=false
#
# Profile 2: secondary (e.g. Legacy / FNM server)
# DEPLOY_SECONDARY_TARGET="user@legacy-server.com"
# DEPLOY_SECONDARY_PATH="/srv/tron"
# DEPLOY_SECONDARY_PORT="3042"
# DEPLOY_SECONDARY_SERVICE_USER="user"
# DEPLOY_SECONDARY_USE_FNM=true

# Server Port (default: 3000)
PORT=3000

# Server Concurrency Limit (default: 50)
MAX_ACTIVE_GAMES=50

# Data Storage Directory (default: ./data)
# DATA_DIR=./data

# Telemetry & Monitoring Security:
# Comma-separated list of external IP addresses allowed to scrape /metrics (localhost is always allowed)
# METRICS_ALLOWED_IPS="198.51.100.2"
# Optional secret token for Bearer authentication (Authorization: Bearer <token> or X-Metrics-Token: <token>)
# METRICS_TOKEN="your-secret-metrics-token"

