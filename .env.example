# Deployment Configuration Example
# Copy this file to .env and configure your remote server details:
# cp .env.example .env

DEPLOY_TARGET="user@your-server.com"
DEPLOY_PATH="/srv/tron"
DEPLOY_PORT="3000"
DEPLOY_SERVICE_USER="tron"

# Set to true if the remote server uses fnm for Node.js management (uses bitcycles-fnm.service)
# Set to false for modern servers with system-wide Node.js (uses hardened bitcycles.service)
DEPLOY_USE_FNM=false

# Server Port (default: 3000)
PORT=3000

# Server Concurrency Limit (default: 50)
MAX_ACTIVE_GAMES=50

# Data Storage Directory (default: ./data)
# DATA_DIR=./data

